# Copie para .env na VPS e preencha. NUNCA commite o .env real.

# --- Banco (Postgres do compose) ---
DB_USERNAME=trilha
DB_PASSWORD=troque-por-uma-senha-forte

# --- MinIO (storage de midia) ---
MINIO_ACCESS_KEY=trilha-minio
MINIO_SECRET_KEY=troque-por-uma-senha-forte

# --- JWT (Cadastro assina os tokens) ---
# Issuer publico dos tokens; em prod aponte para o dominio real do BFF/API
JWT_ISSUER=https://api.seudominio.com
# A chave privada NAO vai por env: monte o PEM em ./keys/jwt-private.pem
# (gerar: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem)

# --- E-mail (confirmacao de cadastro) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@trilha.com
EMAIL_CONFIRMACAO_URL=https://api.seudominio.com/auth/confirmar-email

# --- Login social (opcional; vazio desabilita) ---
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- MQTT (broker exige auth em prod) ---
# Mesmo usuario/senha gerados com mosquitto_passwd e listados no acl.
MQTT_USERNAME=loc-consumer
MQTT_PASSWORD=troque-por-uma-senha-forte

# --- CORS (front web) ---
# Origem publica do front web (separar multiplas por virgula).
CORS_ALLOWED_ORIGINS=https://app.seudominio.com
